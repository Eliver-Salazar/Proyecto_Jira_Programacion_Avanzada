@model JiraClone_EF6.Web.ViewModels.Issues.IssueDetailsViewModel

@{
    ViewBag.Title = Model.IssueKey;
}

@* Razor codifica todo el texto del usuario; no se usa Html.Raw. *@

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <p>
        @Html.ActionLink("Volver a las tareas", "Index",
                 new { projectId = Model.ProjectId }, null)
    </p>

    <div class="card">
        <div class="card-body">
            <span class="badge bg-primary">@Model.IssueKey</span>
            <span class="badge bg-secondary">@Model.StatusName</span>

            <h1 class="mt-3">@Model.Title</h1>
            <p class="text-muted">@Model.ProjectKey · @Model.ProjectName</p>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4" style="white-space: pre-wrap;">@Model.Description</div>
            }

            <dl class="row mt-4">
                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@Model.TypeName</dd>

                <dt class="col-sm-3">Prioridad</dt>
                <dd class="col-sm-9">@Model.PriorityName</dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">@Model.StatusName</dd>

                <dt class="col-sm-3">Creada por</dt>
                <dd class="col-sm-9">@Model.ReporterName</dd>

                <dt class="col-sm-3">Responsable</dt>
                <dd class="col-sm-9">@Model.AssigneeName</dd>

                <dt class="col-sm-3">Vencimiento</dt>
                <dd class="col-sm-9">
                    @(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-dd") : "Sin fecha")
                </dd>

                <dt class="col-sm-3">Creada (UTC)</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                @if (Model.UpdatedAt.HasValue)
                {
                    <dt class="col-sm-3">Actualizada (UTC)</dt>
                    <dd class="col-sm-9">@Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                }

                @if (Model.CompletedAt.HasValue)
                {
                    <dt class="col-sm-3">Finalizada (UTC)</dt>
                    <dd class="col-sm-9">@Model.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                }
            </dl>
        </div>
    </div>

    @* Solo ADMIN/MEMBER ven el formulario; el servicio lo valida igual. *@
    @if (Model.CanWrite)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h2 class="h5">Cambiar estado</h2>

                @if (Model.Transitions.Any())
                {
                    using (Html.BeginForm("ChangeStatus", "Issues",
                               new { projectId = Model.ProjectId, id = Model.IssueId },
                               FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2">
                            @Html.DropDownList("newStatusId", Model.Transitions,
                                     "Seleccione...", new { @class = "form-select w-auto" })
                            <button type="submit" class="btn btn-primary">Cambiar</button>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">
                        No hay transiciones configuradas desde el estado actual.
                    </p>
                }
            </div>
        </div>
    }
</div>
