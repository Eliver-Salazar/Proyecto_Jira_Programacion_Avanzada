@model JiraClone_EF6.Web.ViewModels.Projects.ProjectDetailsViewModel

@{
    ViewBag.Title = "Detalle del proyecto";
}

@* Razor codifica los valores para mostrarlos como texto seguro. *@

@* Mensaje de confirmación después de crear el proyecto. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">
        @TempData["Success"]
    </div>
}

<p>
    @Html.ActionLink("Volver a mis proyectos", "Index")
</p>

<div class="container py-4">
    <div class="card">
        <div class="card-body">
            <span class="badge bg-primary">@Model.ProjectKey</span>

            <h1 class="mt-3">@Model.Name</h1>

            <dl class="row mt-4">
                <dt class="col-sm-3">Identificador</dt>
                <dd class="col-sm-9">@Model.ProjectId</dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    @(Model.IsActive ? "Activo" : "Inactivo")
                </dd>
            </dl>
        </div>
    </div>
</div>