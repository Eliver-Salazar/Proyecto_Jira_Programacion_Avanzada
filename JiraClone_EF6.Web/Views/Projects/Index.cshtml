@model JiraClone_EF6.Web.ViewModels.Projects.ProjectIndexViewModel

@{
    ViewBag.Title = "Mis proyectos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mis proyectos</h1>
        @Html.ActionLink("Crear proyecto", "Create", null,
                 new { @class = "btn btn-primary" })
    </div>

    @* Solo se reciben proyectos accesibles para el usuario actual. *@
    @if (Model.Projects.Count == 0)
    {
        <div class="alert alert-info">
            No hay proyectos para mostrar en esta página.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Clave</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model.Projects)
                    {
                        <tr>
                            <td>@project.ProjectKey</td>
                            <td>@project.Name</td>
                            <td>
                                @Html.ActionLink("Ver detalle", "Details",
                                         new { id = project.ProjectId },
                                         new { @class = "btn btn-outline-primary btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* La paginación evita cargar todos los proyectos en una solicitud. *@
    <div class="d-flex gap-3 align-items-center">
        @if (Model.Page > 1)
        {
            @Html.ActionLink("Anterior", "Index",
                     new { page = Model.Page - 1 },
                     new { @class = "btn btn-outline-secondary" })
        }

        <span>Página @Model.Page</span>

        @if (Model.HasNextPage)
        {
            @Html.ActionLink("Siguiente", "Index",
                     new { page = Model.Page + 1 },
                     new { @class = "btn btn-outline-secondary" })
        }
    </div>
</div>